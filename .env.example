# ===========================
# CultureFlow API Keys
# ===========================
# 이 파일을 .env.local로 복사하고 실제 키를 입력하세요. (.env.local은 git에 올라가지 않습니다)
#   cp .env.example .env.local
# GitHub Actions에서는 같은 이름의 Repository secret을 사용합니다.
# (Settings → Secrets and variables → Actions → New repository secret)
# 키가 없으면 해당 스크래퍼가 "Missing required environment variable ..." 오류로 멈춥니다.

# --- 공공데이터 API (CI + 로컬) ---
# KOPIS 공연예술통합전산망 OpenAPI (scripts/scrape-kopis.ts)
KOPIS_API_KEY=
# KOBIS 영화진흥위원회 OpenAPI (scripts/scrape-movies.ts)
KOBIS_API_KEY=
# 문화포털(KCISA) 문화정보 OpenAPI (scripts/scrape-culture-portal.ts)
KCISA_API_KEY=

# --- TMDB (영화 포스터/메타데이터, scripts/scrape-movies.ts) ---
TMDB_API_KEY=

# --- Kakao ---
# REST 키: 장소 검색/좌표 보정 스크립트용. 허용 IP가 걸려 있어 로컬 Mac mini에서만 사용합니다.
# (CI는 DISABLE_KAKAO_API=1 로 호출하지 않습니다)
KAKAO_REST_API_KEY=
# JS 키: 지도 SDK (빌드 시 주입, GitHub secret NEXT_PUBLIC_KAKAO_JS_KEY)
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- Naver 지역 검색 (선택, 장소 매칭 보조) ---
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# --- Analytics (선택사항) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- 번역 (선택사항) ---
# DEEPL_API_KEY=
# PAPAGO_CLIENT_ID=
# PAPAGO_CLIENT_SECRET=
