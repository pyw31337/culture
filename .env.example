# --- 공공데이터 API ---
KOPIS_API_KEY=
KOBIS_API_KEY=
KCISA_API_KEY=

# --- Kakao ---
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- Analytics (선택사항) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- TMDB (영화 메타데이터) ---
TMDB_API_KEY=

