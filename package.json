{
  "name": "thermal-hypernova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "generate-data": "npx tsx scripts/generate-performance-json.ts",
    "generate:thumbs": "node scripts/generate-local-thumbnails.mjs",
    "build:site": "next build --webpack",
    "build": "npm run generate-data && POSTER_CACHE_INCLUDE_ALL_REMOTE=1 POSTER_CACHE_MAX_NEW_DOWNLOADS=8000 npm run cache:posters && npm run generate:thumbs && npm run validate:content && npm run validate:location-search && npm run validate:locations && npm run validate:display && npm run audit:stability && next build --webpack",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint",
    "scrape:movies": "npx tsx scripts/scrape-movies.ts",
    "scrape:class": "npx tsx scripts/scrape-umclass.ts",
    "scrape:mochaclass": "npx tsx scripts/scrape-mochaclass.ts",
    "scrape:kbo": "npx tsx scripts/scrape-kbo.ts",
    "scrape:ticketbay:sports": "npx tsx scripts/scrape-ticketbay-sports.ts",
    "scrape:yes24": "npx tsx scripts/scrape-yes24-exclusive.ts",
    "scrape:tourism": "npx tsx scripts/scrape-visitkorea-expanded.ts",
    "enrich:myrealtrip": "node scripts/enrich-myrealtrip-details.mjs",
    "scrape:sssd": "npx tsx scripts/scrape-sssd.ts",
    "validate:images": "npx tsx scripts/validate-images.ts",
    "validate:content": "npx tsx scripts/validate-content-quality.ts",
    "validate:details": "npx tsx scripts/validate-detail-completeness.ts",
    "validate:search": "npx tsx scripts/validate-search-consistency.ts",
    "validate:location-search": "npx tsx scripts/validate-location-search-contract.ts",
    "validate:locations": "npx tsx scripts/validate-location-integrity.ts",
    "validate:display": "npx tsx scripts/validate-display-integrity.ts",
    "audit:locations": "npx tsx scripts/audit-location-mismatches.ts",
    "audit:sources": "npx tsx scripts/audit-source-funnel.ts",
    "audit:sources:quality": "npx tsx scripts/audit-source-completeness.ts",
    "audit:sources:quality:write": "npx tsx scripts/audit-source-completeness.ts --write",
    "audit:venues:canonical": "npx tsx scripts/audit-venue-canonicalization.ts",
    "audit:stability": "npx tsx scripts/audit-service-stability.ts",
    "build:venue-master": "npx tsx scripts/build-venue-master.ts",
    "enrich:venue-places": "npx tsx scripts/enrich-venue-places.ts",
    "local:update-data": "scripts/run-local-data-update.sh",
    "local:check-update-status": "scripts/check-local-data-update-status.sh",
    "local:install-scheduler": "scripts/install-local-data-update.sh",
    "audit:map-navigation": "npx tsx scripts/audit-map-navigation.ts",
    "cache:posters": "npx tsx scripts/cache-remote-posters.ts"
  },
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "axios": "^1.13.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.4.2",
    "framer-motion": "^12.23.26",
    "iconv-lite": "^0.7.0",
    "lucide-react": "^0.556.0",
    "lz-string": "^1.5.0",
    "next": "^16.1.6",
    "next-nprogress-bar": "^2.4.7",
    "next-pwa": "^2.0.2",
    "p-limit": "^7.2.0",
    "puppeteer": "^19.8.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/csv-parse": "^1.1.12",
    "@types/csv-stringify": "^1.4.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.12.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cli-progress": "^3.12.0",
    "csv-parse": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "playwright": "^1.57.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
